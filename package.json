{
  "name": "aeris-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Aeris Client monorepo: shared contract layer, mobile (Expo), and client (Electron v2). Archive (desktop-v1) is excluded from workspaces and built only on-demand.",
  "workspaces": [
    "shared",
    "mobile",
    "client"
  ],
  "scripts": {
    "test:all": "npm test --workspaces --if-present",
    "typecheck": "tsc --build",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "jest-util": "^29.7.0"
  },
  "overrides": {
    "@babel/core@^7": "^7.29.13",
    "@react-navigation/core@^7": "^7.24.0",
    "@tootallnate/once": "^2.0.1",
    "@xmldom/xmldom@^0.8.0": "^0.8.15",
    "@xmldom/xmldom@^0.9.0": "^0.9.12",
    "baseline-browser-mapping@^2": "^2.11.35",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^2": "^2.1.7",
    "brace-expansion@^5": "^5.0.12",
    "browserslist@^4": "^4.29.5",
    "builder-util-runtime@^9": "^9.7.1",
    "compression@^1": "^1.8.2",
    "deepmerge": "4.1.1",
    "esbuild": "^0.25.0",
    "fast-uri@^3": "^3.1.9",
    "form-data@^4": "^4.0.6",
    "glob@^13": "^14.0.4",
    "handlebars@^4": "^4.7.10",
    "image-size@^1": "^2.1.0",
    "js-yaml@^3": "^3.15.2",
    "js-yaml@^4": "^4.3.2",
    "minimatch@^10": "^11.0.5",
    "minimatch@^3": "^3.1.3",
    "minimatch@^9": "^11.0.5",
    "node-forge@^1": "^1.4.3",
    "picomatch@^2": "^2.3.2",
    "picomatch@^4": "^4.0.4",
    "postcss": "^8.5.10",
    "shell-quote@^1": "^1.12.0",
    "tar": "^7.5.18",
    "uuid@^7": "^11.1.1",
    "vite": "^6.4.4",
    "ws@^7": "^7.5.13",
    "ws@^8": "^8.20.2",
    "zod@^3": "^4.6.7"
  }
}
